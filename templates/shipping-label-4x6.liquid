<div style="width:3.64in; min-height:5.64in; margin:auto; padding:0; display:flex; flex-direction:column; font-family:Arial, Helvetica, sans-serif; font-size:9.5px; color:#111; box-sizing:border-box;">

  <div style="text-align:center;">
    <img src="https://cdn.shopify.com/s/files/1/0862/8246/9671/files/logo.svg" alt="{{ shop.name }}" width="50" style="width:50px; max-width:50px; height:auto;">
  </div>

  <div style="text-align:center; margin-top:0.6em;">
    <p style="margin:0; font-size:1.1em; font-weight:bold; letter-spacing:0.04em;">
      Customer ID : 1160026976
    </p>
  </div>

  <hr style="height:0.045em; border:none; background-color:#111; color:#111; margin:0.5em 0;">

  <div style="padding:0.1em 0;">
    <p style="margin:0 0 0.35em; font-weight:bold; font-size:0.85em; color:#555; text-transform:uppercase;">
      From
    </p>
    <p style="margin:0; font-size:1em; line-height:1.5;">
      {{ shop.name }}<br>
      {{ shop_address.summary }}
      {% if shop.phone != blank %}<br>Ph: {{ shop.phone }}{% endif %}
    </p>
  </div>

  <hr style="height:0.03em; border:none; background-color:#ccc; color:#ccc; margin:0.5em 0;">

  <div style="padding:0.3em 0 0.2em;">
    <p style="margin:0 0 0.35em; font-weight:bold; font-size:1em; color:#555; text-transform:uppercase;">
      Ship to
    </p>
    <p style="margin:0; font-size:1em; line-height:1.4; font-weight:500;">
      <strong>{{ shipping_address.name }}</strong><br>
      {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}<br>
      <strong>{{ shipping_address.city_province_zip }}</strong><br>
      {{ shipping_address.country }}
      {% if shipping_address.phone != blank %}<br>Ph: {{ shipping_address.phone }}{% endif %}
    </p>
  </div>

  <div style="margin-top:0.7em; padding:0.5em 0.6em; border:0.04em solid #111; box-sizing:border-box;">
    <div style="display:flex; justify-content:space-between; padding:0.15em 0; font-size:1em;">
      <span style="color:#555;">Order</span>
      <span style="font-weight:bold; text-align:right;">{{ order.name }}</span>
    </div>
    <div style="display:flex; justify-content:space-between; padding:0.15em 0; font-size:1em;">
      <span style="color:#555;">Date</span>
      <span style="font-weight:bold; text-align:right;">{{ order.created_at | date: format: 'date' }}</span>
    </div>
    {% if order.financial_status != blank %}
      <div style="display:flex; justify-content:space-between; padding:0.15em 0; font-size:1em;">
        <span style="color:#555;">Payment</span>
        <span style="font-weight:bold; text-align:right; text-transform:uppercase;">{{ order.financial_status | replace: '_', ' ' }}</span>
      </div>
    {% endif %}
    {% if order.total_price != blank %}
      <div style="display:flex; justify-content:space-between; padding:0.15em 0; font-size:1em;">
        <span style="color:#555;">Amount</span>
        <span style="font-weight:bold; text-align:right;">{{ order.total_price | money_with_currency }}</span>
      </div>
    {% endif %}
  </div>

  <div style="flex-grow:1;"></div>

  <hr style="height:0.045em; border:none; background-color:#111; color:#111; margin:0.5em 0;">

  <div style="margin-top:0.4em; display:flex; justify-content:space-between; align-items:flex-end; gap:0.5em;">
    <p style="margin:0; font-size:0.75em; line-height:1.4; color:#555;">
      <span style="font-weight:bold; text-transform:uppercase;">Return Address:</span>
      {{ shop.name }}, {{ shop_address.summary }}
    </p>
    <span style="font-size:0.8em; color:#555; white-space:nowrap;">Page 1 of 1</span>
  </div>

</div>
