  }

  .label {
    width: 3.64in;
    min-height: 5.64in;
    margin: auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9.5px;
    color: #111;
  }

  .to-uppercase {
    text-transform: uppercase;
  }

  p {
    margin: 0;
  }

  hr {
    height: 0.045em;
    border: none;
    background-color: #111;
    color: #111;
    margin: 0.5em 0;
  }

  .subdued-separator {
    height: 0.03em;
    background-color: #ccc;
    color: #ccc;
  }

  .label-header {
    text-align: center;
  }

  .shop-logo {
    width: 150px;
    max-width: 100%;
    height: auto;
  }

  .customer-id-block {
    text-align: center;
    margin-top: 0.6em;
  }

  .customer-id {
    font-size: 1.1em;
    font-weight: bold;
    letter-spacing: 0.04em;
  }

  .block-label {
    font-weight: bold;
    font-size: 0.85em;
    color: #555;
    margin-bottom: 0.35em;
  }

  .from-block {
    padding: 0.1em 0;
  }

  .from-detail {
    font-size: 1em;
    line-height: 1.5;
  }

  .to-block {
    padding: 0.3em 0 0.2em;
  }

  .to-detail {
    font-size: 1.6em;
    line-height: 1.45;
    font-weight: 500;
  }

  .meta-block {
    margin-top: 0.7em;
    padding: 0.5em 0.6em;
    border: 0.04em solid #111;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    padding: 0.15em 0;
    font-size: 1em;
  }

  .meta-label {
    color: #555;
  }

  .meta-value {
    font-weight: bold;
    text-align: right;
  }

  .spacer {
