<div class="label">
  <div class="label-header">
    <img class="shop-logo" src="https://cdn.shopify.com/s/files/1/0862/8246/9671/files/logo.svg" alt="{{ shop.name }}" width="150" style="width:150px; max-width:150px; height:auto;">
  </div>

  <div class="customer-id-block">
    <p class="customer-id">
      Customer ID : 1160026976
    </p>
  </div>

  <hr>

  <div class="from-block">
    <p class="block-label to-uppercase">
      From
    </p>
    <p class="from-detail">
      {{ shop.name }}<br>
      {{ shop_address.summary }}
      {% if shop.phone != blank %}<br>Ph: {{ shop.phone }}{% endif %}
    </p>
  </div>

  <hr class="subdued-separator">

  <div class="to-block">
    <p class="block-label to-uppercase">
      Ship to
    </p>
    <p class="to-detail">
      <strong>{{ shipping_address.name }}</strong><br>
      {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}<br>
      <strong>{{ shipping_address.city_province_zip }}</strong><br>
      {{ shipping_address.country }}
      {% if shipping_address.phone != blank %}<br>Ph: {{ shipping_address.phone }}{% endif %}
    </p>
  </div>

  <div class="meta-block">
    <div class="meta-row">
      <span class="meta-label">Order</span>
      <span class="meta-value">{{ order.name }}</span>
    </div>
    <div class="meta-row">
      <span class="meta-label">Date</span>
      <span class="meta-value">{{ order.created_at | date: format: 'date' }}</span>
    </div>
    {% if order.financial_status != blank %}
      <div class="meta-row">
        <span class="meta-label">Payment</span>
        <span class="meta-value to-uppercase">{{ order.financial_status | replace: '_', ' ' }}</span>
      </div>
    {% endif %}
    {% if order.total_price != blank %}
      <div class="meta-row">
        <span class="meta-label">Amount</span>
        <span class="meta-value">{{ order.total_price | money_with_currency }}</span>
      </div>
    {% endif %}
  </div>

  <div class="spacer"></div>

  <hr>

  <div class="return-block">
    <p class="return-label to-uppercase">Return Address</p>
    <p class="return-detail">
      {{ shop.name }}, {{ shop_address.summary }}
    </p>
  </div>

  <div class="footer">
    Page 1 of 1
  </div>
</div>

<style type="text/css">
