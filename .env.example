# Shopify (Partner Dashboard → your app → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://ship.lunabee.in
SHOPIFY_API_VERSION=2026-07
# Storefront path of the app proxy (prefix/subpath in shopify.app.toml)
SHOPIFY_APP_PROXY_PATH=/apps/track

# India Post — UAT host; switch to the production host India Post gives you at go-live
INDIAPOST_BASE_URL=https://test.cept.gov.in/beextcustomer
# Legacy shared webhook secret (?secret=...). Each store also has its own private webhook link in Settings.
INDIAPOST_WEBHOOK_SECRET=change-me
# Optional comma separated India Post source IPs allowed to call the webhook
INDIAPOST_WEBHOOK_IPS=

# 32 byte key (64 hex chars) used to encrypt India Post passwords at rest: openssl rand -hex 32
ENCRYPTION_KEY=

# Public IP of this server, shown in Settings for India Post whitelisting
SERVER_PUBLIC_IP=

PORT=3000
# Number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=1
DATABASE_PATH=./data/app.db
LABEL_DIR=./data/labels
# How often to poll India Post bulk tracking for in-flight shipments (0 disables)
TRACKING_POLL_MINUTES=30
