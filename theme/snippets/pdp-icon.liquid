    {%- when 'dry' -%}
      <circle cx="16" cy="16" r="11"/><path d="M13 11h3.5a5 5 0 0 1 0 10H13z"/>
    {%- when 'tumble' -%}
      <path d="M5 5h22v22H5z"/><circle cx="16" cy="16" r="7"/><circle cx="16" cy="16" r="1"/>
    {%- else -%}
