      <path d="M7 25C7 13 14 6 26 6c0 12-7 19-19 19z M7 25l10-10"/>
    {%- when 'gift' -%}
      <path d="M5 12h22v5H5z M7 17h18v10H7z M16 12v15 M16 12c-2-5-8-5-7-1.5S16 12 16 12zm0 0c2-5 8-5 7-1.5S16 12 16 12z"/>
