{%- comment -%}
  Renders an image, or a labelled placeholder tile when the merchant has not
  set one yet — so every section looks intentional in an empty store.

  @param {image} [image]  - the image to render
  @param {string} [label] - placeholder caption, e.g. "CAMPAIGN STILL"
  @param {string} [ratio] - aspect-ratio, e.g. "3/4". Omit to fill the parent.
  @param {string} [class] - extra classes on the wrapper
  @param {string} [sizes] - responsive sizes attribute
  @param {string} [tone]  - "sand" (default) or "clay" or "plum"
  @param {boolean} [eager] - load eagerly (above the fold)
{%- endcomment -%}

{%- liquid
  assign tone = tone | default: 'sand'
  assign sizes = sizes | default: '(min-width: 768px) 50vw, 100vw'
  case tone
    when 'plum'
      assign tone_class = 'bg-plum text-cream/45'
    when 'clay'
      assign tone_class = 'bg-clay text-plum/45'
    else
      assign tone_class = 'bg-sand text-plum/45'
  endcase
  if eager
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
-%}

<div
  class="relative overflow-hidden {{ class }}"
  {% if ratio %}style="aspect-ratio: {{ ratio }};"{% endif %}
>
  {%- if image != blank -%}
    <img
      src="{{ image | image_url: width: 1600 }}"
      srcset="
        {{ image | image_url: width: 400 }} 400w,
        {{ image | image_url: width: 800 }} 800w,
        {{ image | image_url: width: 1200 }} 1200w,
        {{ image | image_url: width: 1600 }} 1600w
      "
      sizes="{{ sizes }}"
      alt="{{ image.alt | escape }}"
      width="{{ image.width }}"
      height="{{ image.height }}"
      loading="{{ loading }}"
      class="absolute inset-0 h-full w-full object-cover"
    >
  {%- else -%}
    <div class="absolute inset-0 grid place-items-center {{ tone_class }}">
      <span class="text-[14px] tracking-widest2 uppercase">{{ label | default: 'Image' }}</span>
    </div>
  {%- endif -%}
</div>
