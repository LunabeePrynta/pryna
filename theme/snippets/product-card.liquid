{%- comment -%}
  @param {product} product
  @param {string} [sizes]
{%- endcomment -%}

{%- liquid
  assign card_sizes = sizes | default: '(min-width: 1024px) 25vw, 50vw'
-%}

<article>
  <a href="{{ product.url }}" class="group block">
    <div class="relative overflow-hidden card-media">
      {% render 'media',
        image: product.featured_image,
        label: product.title,
        ratio: '3/4',
        tone: 'sand',
        sizes: card_sizes
      %}
      {%- unless product.available -%}
        <span class="absolute top-3 left-3 bg-paper/95 text-plum text-ui tracking-widest2 uppercase px-2.5 py-1.5">
          {{ 'products.product.sold_out' | t }}
        </span>
      {%- endunless -%}
    </div>
    {%- comment -%}
      Title and price share a baseline with the price pinned right, under a
      hairline. The title is allowed to wrap; the price is shrink-0 so a long
      name pushes down rather than squeezing the figure.
    {%- endcomment -%}
    <div class="mt-3.5">
      <div class="flex items-baseline justify-between gap-4 pb-1 border-b border-plum/25">
        <h3 class="product-name text-plum text-[20px] leading-tight group-hover:text-amber transition-colors">{{ product.title }}</h3>
        {% render 'price', product: product, class: 'text-ui text-plum shrink-0 whitespace-nowrap' %}
      </div>
      {%- if product.type != blank -%}
        <p class="mt-2 text-ui tracking-widest2 uppercase text-ink">{{ product.type }}</p>
      {%- endif -%}
    </div>
  </a>
</article>
