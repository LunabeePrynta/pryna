{%- comment -%}
  @param {product} product
  @param {string} [sizes]
{%- endcomment -%}

{%- liquid
  assign card_sizes = sizes | default: '(min-width: 1024px) 25vw, 50vw'
-%}

<article>
  <a href="{{ product.url }}" class="group block">
    <div class="relative overflow-hidden card-media">
      {% render 'media',
        image: product.featured_image,
        label: product.title,
        ratio: '3/4',
        tone: 'sand',
        sizes: card_sizes
      %}
      {%- comment -%}
        Second shot for the hover swap. Decorative: it is the same product and
        the primary image already carries the alt text.
      {%- endcomment -%}
      {%- if product.images.size > 1 -%}
        {%- assign alt_image = product.images[1] -%}
        <img
          class="card-alt"
          src="{{ alt_image | image_url: width: 800 }}"
          srcset="
            {{ alt_image | image_url: width: 400 }} 400w,
            {{ alt_image | image_url: width: 800 }} 800w,
            {{ alt_image | image_url: width: 1200 }} 1200w
          "
          sizes="{{ card_sizes }}"
          alt=""
          aria-hidden="true"
          width="{{ alt_image.width }}"
          height="{{ alt_image.height }}"
          loading="lazy"
        >
      {%- endif -%}
      {%- unless product.available -%}
        <span class="absolute top-3 left-3 bg-paper/95 text-plum text-ui tracking-widest2 uppercase px-2.5 py-1.5">
          {{ 'products.product.sold_out' | t }}
        </span>
      {%- endunless -%}
    </div>
    {%- comment -%}
      Title and price share a baseline with the price pinned right. The title
      is allowed to wrap; the price is shrink-0 so a long name pushes the row
      taller rather than squeezing the figure.
    {%- endcomment -%}
    <div class="mt-3.5">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="product-name text-plum text-[16px] font-medium leading-tight group-hover:text-amber transition-colors">{{ product.title }}</h3>
        {% render 'price', product: product, class: 'text-[18px] text-plum shrink-0 whitespace-nowrap' %}
      </div>
      {%- if product.type != blank -%}
        <p class="mt-2 text-ui tracking-widest2 uppercase text-ink">{{ product.type }}</p>
      {%- endif -%}
    </div>
  </a>
</article>
