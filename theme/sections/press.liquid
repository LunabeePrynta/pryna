<section class="py-14 md:py-20 bg-sand/60">
  <div class="wrap">
    <p class="section-label eyebrow mb-10 md:mb-14">{{ section.settings.label }}</p>

    <div class="grid gap-10 md:grid-cols-3 md:gap-12" data-anim="stagger">
      {%- for block in section.blocks -%}
        <blockquote class="flex flex-col" {{ block.shopify_attributes }}>
          <p class="font-display italic text-plum text-[22px] md:text-[25px] leading-snug">
            &ldquo;{{ block.settings.quote }}&rdquo;
          </p>
          <cite class="mt-5 not-italic text-[10px] tracking-widest2 uppercase text-amber">
            {{ block.settings.source }}
          </cite>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Press",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "06 — As seen in" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The rare children's label that treats a bodysuit like couture." },
        { "type": "text", "id": "source", "label": "Source", "default": "Vogue India" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Press",
      "blocks": [
        { "type": "quote", "settings": { "quote": "The rare children's label that treats a bodysuit like couture.", "source": "Vogue India" } },
        { "type": "quote", "settings": { "quote": "Heirloom quality without the heirloom fussiness.", "source": "Elle Decor" } },
        { "type": "quote", "settings": { "quote": "Every mother we know has a Lyra swaddle in the hospital bag.", "source": "Mother & Baby" } }
      ]
    }
  ]
}
{% endschema %}
