<section class="pb-14 md:pb-24">
  <div class="wrap">
    <p class="section-label eyebrow mb-8 md:mb-12">{{ section.settings.label }}</p>

    <div
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5"
      data-anim="stagger"
    >
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.url | default: routes.all_products_collection_url }}"
          class="group block"
          {{ block.shopify_attributes }}
        >
          <div class="ward-media overflow-hidden">
            {% render 'media',
              image: block.settings.image,
              label: block.settings.title,
              ratio: '4/5',
              tone: 'sand',
              sizes: '(min-width: 1024px) 20vw, (min-width: 640px) 33vw, 50vw'
            %}
          </div>
          <div class="mt-3 flex items-baseline justify-between">
            <h3 class="font-display text-plum text-[19px] md:text-[21px] leading-none group-hover:text-amber transition-colors">
              {{ block.settings.title }}
            </h3>
            <span class="text-ui tracking-widest2 text-plum">{{ block.settings.count }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ward-media img { transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1); }
  .group:hover .ward-media img { transform: scale(1.05); }
{% endstylesheet %}

{% schema %}
{
  "name": "The wardrobe",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "02 — The wardrobe" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Bodysuits" },
        { "type": "text", "id": "count", "label": "Count", "default": "14" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "The wardrobe",
      "blocks": [
        { "type": "category", "settings": { "title": "Bodysuits", "count": "14" } },
        { "type": "category", "settings": { "title": "Dresses", "count": "22" } },
        { "type": "category", "settings": { "title": "Co-ord sets", "count": "18" } },
        { "type": "category", "settings": { "title": "Sleepwear", "count": "11" } },
        { "type": "category", "settings": { "title": "Swaddles", "count": "9" } }
      ]
    }
  ]
}
{% endschema %}
