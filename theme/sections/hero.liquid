{%- liquid
  assign s = section.settings
-%}

<section class="pt-10 md:pt-16 pb-0 overflow-hidden">
  <div class="wrap">

    {%- comment -%} Headline + intro {%- endcomment -%}
    <div class="grid gap-8 lg:grid-cols-[1.45fr_1fr] lg:gap-16 lg:items-end">
      <h1 class="font-display text-plum leading-[0.94] text-[clamp(2.9rem,8.2vw,5.75rem)]">
        <span class="block overflow-hidden"><span class="block" data-hero-line>{{ s.line_1 }}</span></span>
        <span class="block overflow-hidden">
          <span class="block" data-hero-line>
            {{ s.line_2 }}
            <em class="not-italic font-display text-amber italic">{{ s.line_accent }}</em>
          </span>
        </span>
      </h1>

      <div class="lg:pb-3">
        <p class="max-w-md text-[15.5px] font-light leading-relaxed text-ink">{{ s.intro }}</p>
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_url | default: routes.all_products_collection_url }}" class="btn btn-solid mt-7">
            {{ s.button_label }}
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      Three-panel gallery. The middle panel drops lower on desktop to break
      the baseline and give the row an editorial rhythm.
    {%- endcomment -%}
    <div class="mt-12 md:mt-16 grid gap-5 md:gap-6 md:grid-cols-3 items-start">

      <figure>
        <div data-anim="reveal">
          {% render 'media',
            image: s.image_1,
            label: s.caption_1_label,
            ratio: '3/4',
            tone: 'sand',
            eager: true,
            sizes: '(min-width: 768px) 33vw, 100vw'
          %}
        </div>
        <figcaption class="mt-3 flex items-baseline justify-between text-ui tracking-widest2 uppercase text-plum">
          <span>{{ s.caption_1_label }}</span>
          <span class="hero-meta">{{ s.caption_1_meta }}</span>
        </figcaption>
      </figure>

      <figure class="md:mt-14">
        <div data-anim="reveal">
          {% render 'media',
            image: s.image_2,
            label: s.caption_2_label,
            ratio: '4/5',
            tone: 'plum',
            sizes: '(min-width: 768px) 33vw, 100vw'
          %}
        </div>
        <figcaption class="mt-3 flex items-baseline justify-between text-ui tracking-widest2 uppercase text-plum">
          <span>{{ s.caption_2_label }}</span>
          <span class="hero-meta">{{ s.caption_2_meta }}</span>
        </figcaption>
      </figure>

      <figure class="md:-mt-4">
        <div data-anim="reveal">
          {% render 'media',
            image: s.image_3,
            label: s.caption_3_label,
            ratio: '3/4',
            tone: 'clay',
            sizes: '(min-width: 768px) 33vw, 100vw'
          %}
        </div>
        <figcaption class="mt-3 flex items-baseline justify-between text-ui tracking-widest2 uppercase text-plum">
          <span>{{ s.caption_3_label }}</span>
          <span class="hero-meta">{{ s.caption_3_meta }}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

{% stylesheet %}
  /* The caption meta reads as the price/edition marker, so it sits larger than
     the label beside it. line-height:1 keeps the taller text from deepening the
     caption row, and the tighter tracking stops it wrapping in a narrow column. */
  .hero-meta {
    font-size: 25px;
    line-height: 1;
    letter-spacing: 0.06em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "line_1", "label": "Headline line 1", "default": "Heirloom clothing" },
    { "type": "text", "id": "line_2", "label": "Headline line 2", "default": "for the very" },
    { "type": "text", "id": "line_accent", "label": "Accent word", "default": "new" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Hand-finished in Indian cotton, silk and khadi voile. Made for first breaths, first steps, and the photographs you keep forever." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "header", "content": "Panel 1" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "caption_1_label", "label": "Caption", "default": "Frill set · Cotton" },
    { "type": "text", "id": "caption_1_meta", "label": "Caption meta", "default": "₹4,200" },
    { "type": "header", "content": "Panel 2" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "caption_2_label", "label": "Caption", "default": "The Monsoon Edit" },
    { "type": "text", "id": "caption_2_meta", "label": "Caption meta", "default": "SS26" },
    { "type": "header", "content": "Panel 3" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "caption_3_label", "label": "Caption", "default": "Hand embroidery" },
    { "type": "text", "id": "caption_3_meta", "label": "Caption meta", "default": "Detail" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
