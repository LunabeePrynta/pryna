<section class="py-10 md:py-16">
  <div class="wrap">
    <p class="eyebrow mb-4">{{ collection.products_count }} {% if collection.products_count == 1 %}item{% else %}items{% endif %}</p>
    <h1 class="font-display text-plum text-[40px] md:text-[60px] leading-none">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="mt-4 max-w-xl text-[15px] font-light leading-relaxed text-ink/70">{{ collection.description }}</div>
    {%- endif -%}

    {%- paginate collection.products by 24 -%}
    <div class="mt-10 md:mt-14 grid gap-x-5 gap-y-10 grid-cols-2 lg:grid-cols-4" data-anim="stagger">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="col-span-full text-ink/60">No products yet.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="mt-14 flex justify-center gap-3 text-[14px] tracking-widest2 uppercase">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="link-underline">Prev</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="link-underline">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .card-media img { transition: transform 1.1s cubic-bezier(0.22,1,0.36,1); }
  .group:hover .card-media img { transform: scale(1.045); }
{% endstylesheet %}

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
